:root {
    --panel-color-1: rgb(0, 0, 0);
    justify-content: center;
}

#header {
    height: 10%;
    justify-content: center;
}

#footer {
    height: 10%;
}

#content {
    height: 80%;
    justify-content: center;
}

#welcome-label {
    position: absolute;
    align-self: center;
    width: 50%;
    height: 300px;
    top: 4%;
    font-size: 56px;
    color: white;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0 0 4px 0;
    border-color: white;
}

#info-label {
    align-self: center;
    position: absolute;
    bottom: 12%;
    width: 80%;
    font-size: 36px;
    color: white;
    white-space: normal;
    -unity-text-align: middle-center;
}

#controls-label {
    align-self: center;
    -unity-text-align: middle-center;
    color: white;
    font-size: 64px;
    -unity-font-style: bold;
}

.unity-button {
    position: absolute;
    bottom: 30%;
    width: 156px;
    height: 72px;
    border-radius: 32px;
    border-width: 4px;
    background-color: white;
    border-color: rgb(136, 51, 203);
    color: black;
    font-size: 22px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.2s;
}

.unity-button:hover {
    background-color: rgb(136, 51, 203);
    border-color: white;
    color: white;
    transition-property: background-color, border-color, color;
    transition-duration: 0.2s;
}

.left-anchor {
    left: 52px;
}

.right-anchor {
    right: 52px;
}

.panel {
    align-self: center;
    position: absolute;
    width: 52%;
    height: 90%;
    background-color: var(--panel-color-1);
    border-radius: 16px;
}

.visibility-hidden {
    visibility: hidden;
}

.visibility-show {
    visibility: visible;
}

.flex-grow {
    flex-grow: 1;
}
